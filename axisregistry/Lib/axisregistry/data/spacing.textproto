# SPAC based on https://fonts.google.com/specimen/Shantell+Sans and https://github.com/googlefonts/roboto-flex-spacing-axis-demo
tag: "SPAC"
display_name: "Spacing"
min_value: -100.0
default_value: 0.0
max_value: 100.0
precision: -1
fallback {
  name: "Default"
  value: 0
}
fallback_only: false
description:
  "Adjusts the overall letter spacing of a font. "
  "The range is a relative percentage change from "
  "the family’s default spacing, so the default value is 0."
